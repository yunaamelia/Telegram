[Unit]
Description=FRIENDS Store Telegram Bot
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/telegram-bot-friends-store
Environment=PATH=/opt/telegram-bot-friends-store/venv/bin
ExecStart=/opt/telegram-bot-friends-store/venv/bin/python main.py
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=telegram-bot

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
